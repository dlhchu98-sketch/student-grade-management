# ==============================================================================
# CẤU HÌNH KẾT NỐI MICROSOFT SQL SERVER (.env.example)
# Sao chép file này thành .env và điều chỉnh thông số phù hợp với máy của bạn
# ==============================================================================

# Tên SQL Server Instance (ví dụ: localhost, .\SQLEXPRESS)
DB_SERVER=.\SQLEXPRESS

# Tên Database trên SQL Server (hệ thống tự động khởi tạo nếu chưa có)
DB_NAME=StudentGradeManagementDB

# Sử dụng Windows Authentication (yes = Windows Auth, no = SQL Server Auth)
DB_TRUSTED_CONNECTION=yes

# Nếu DB_TRUSTED_CONNECTION=no, điền tài khoản và mật khẩu SQL Server tại đây:
DB_USER=
DB_PASSWORD=

# Tùy chọn chỉ định ODBC Driver (nếu để trống hệ thống sẽ tự động phát hiện Driver 18/17)
# DB_DRIVER=ODBC Driver 18 for SQL Server
